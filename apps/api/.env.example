# ─── Base de datos ────────────────────────────────────────────────────────────
# Configura con tus credenciales locales de PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/control_alumnos"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Genera un secreto aleatorio: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CAMBIAR_POR_SECRETO_ALEATORIO_MINIMO_32_BYTES"
JWT_EXPIRES_IN="15m"
JWT_ISSUER="umx-control-alumnos"
JWT_AUDIENCE="umx-control-alumnos-api"

# ─── Refresh Token ────────────────────────────────────────────────────────────
REFRESH_TOKEN_EXPIRES_DAYS=7

# ─── Servidor ─────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ─── CORS (origin del frontend en desarrollo) ────────────────────────────────
CORS_ORIGIN="http://localhost:5173"
# ─── Google OAuth ───────────────────────────────────────────────────────────────
# Obténlo en: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0
GOOGLE_CLIENT_ID="tu_client_id.apps.googleusercontent.com"

# ─── API pública (consulta de alumnos por matrícula, para integraciones externas) ─
# Genera una clave aleatoria: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUBLIC_API_KEY="CAMBIAR_POR_CLAVE_ALEATORIA_MINIMO_16_CARACTERES"
# ─── Semilla (seed.ts) ────────────────────────────────────────────────────────
# Contraseña temporal del primer Super Admin (se fuerza cambio en primer login)
SEED_ADMIN_PASSWORD="CambiarEnPrimerLogin123!"

# ─── SMTP (envío de correos, ej. contraseña temporal al activar acceso de Alumno) ─
# Si se deja vacío, el envío se omite (solo se loguea un warning) sin romper el flujo.
SMTP_HOST="smtp.ejemplo.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="no-reply@mondragonmexico.edu.mx"
SMTP_PASS="CAMBIAR"
SMTP_FROM="Control de Alumnos UMx <no-reply@mondragonmexico.edu.mx>"

